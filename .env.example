# --- 관리자 잠금 (Phase 0) ---
# 클라이언트 번들에 실리는 값이다. 인증이 아니라 실수 방지용 잠금.
NEXT_PUBLIC_ADMIN_PASSWORD=

# --- 크론 (Phase 2) ---
# openssl rand -hex 32
# Vercel 크론은 이 값을 Authorization: Bearer 로 자동 첨부한다.
CRON_SECRET=

# --- Firestore (Phase 2) ---
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 으로 받은 JSON에서 옮긴다.
# PRIVATE_KEY는 개행이 \n 으로 이스케이프된 한 줄 그대로 넣으면 된다(따옴표는 있어도 벗겨진다).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- 웹 푸시 (Phase 3) ---
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 연락할 주소. mailto: 형식이어야 한다.
VAPID_SUBJECT=mailto:kouljin@gmail.com
